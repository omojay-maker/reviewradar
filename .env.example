# ReviewRadar API environment
APP_ENV=production
# Leave blank when the frontend and API share an origin. Otherwise set one exact origin.
APP_CORS_ORIGIN=
JWT_SECRET=generate-a-unique-secret-with-php-r
JWT_TTL=3600

# PostgreSQL connection. DATABASE_URL takes precedence when set.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=reviewradar
DB_USER=reviewradar_app
DB_PASSWORD=replace-with-a-database-password
DB_SSLMODE=prefer

GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30
GROQ_CONCURRENCY=5

# Optional. Defaults to pdftotext on PATH or /usr/bin/pdftotext.
PDFTOTEXT_BIN=
